rules_version = '2';

// Storage cannot evaluate Firestore, so uploads are limited by size and
// type instead of by role. The upload path is only reachable from the
// authenticated admin panel (the public site never writes to Storage).
service firebase.storage {
  match /b/{bucket}/o {

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underOneMb() {
      return request.resource.size < 1 * 1024 * 1024;
    }

    // Published assets (logos, testimonials, settings) are world readable.
    // Authenticated admins may replace or remove them.
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isImage() && underOneMb();
    }

    match /testimonials/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isImage() && underOneMb();
    }

    // Project media is admin-only (the public site uses Firestore photo URLs
    // that point at these same public objects).
    match /projects/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isImage() && underOneMb();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
